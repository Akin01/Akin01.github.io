---
// src/components/ContactSection.astro
---

<section class="py-16 sm:py-20 bg-[#07080d]" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (Prefix title only, no big title, no divider) -->
    <div class="mb-10">
      <h2 class="font-mono text-xs sm:text-sm text-cyan-400 tracking-widest font-semibold uppercase">
        // CONTACT
      </h2>
    </div>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Primary Comms Panel (7 cols) -->
      <div class="lg:col-span-7 space-y-4 font-mono">
        <!-- Status Bar -->
        <div class="p-4 bg-[#0a0c12] border border-[#1b202e] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 bg-emerald-400 inline-block animate-pulse"></span>
            <span class="font-bold text-white text-xs tracking-wider">COMMS_LINK: ACTIVE</span>
          </div>
          <span class="text-[10px] text-cyan-400 bg-[#141a28] px-2.5 py-1 border border-[#232f4a] font-bold">
            OPEN FOR STAFF / MIDDLE / SENIOR ROLES
          </span>
        </div>

        <!-- 2 Main Contact Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Email Card -->
          <div class="p-4 bg-[#0a0c12] border border-[#1b202e] space-y-2.5">
            <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">ELECTRONIC MAIL</div>
            <div class="text-xs font-bold text-slate-200 select-all truncate" id="email-text">akinpasha82@gmail.com</div>
            <button 
              type="button" 
              id="copy-email-btn"
              class="w-full py-2 bg-cyan-400 hover:bg-cyan-300 text-black text-xs font-bold transition-colors flex items-center justify-center gap-1.5"
            >
              <span id="copy-text">COPY EMAIL ADDRESS</span>
            </button>
          </div>

          <!-- WhatsApp Card -->
          <div class="p-4 bg-[#0a0c12] border border-[#1b202e] space-y-2.5">
            <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">PHONE / WHATSAPP</div>
            <div class="text-xs font-bold text-slate-200 select-all">+62 819 1797 3875</div>
            <a 
              href="https://wa.me/6281917973875" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-2 bg-[#141d18] hover:bg-[#1e2d24] text-emerald-400 border border-[#233f30] text-xs font-bold transition-colors flex items-center justify-center gap-1.5"
            >
              MESSAGE ON WHATSAPP &rarr;
            </a>
          </div>
        </div>

        <!-- Location Card -->
        <div class="p-4 bg-[#0a0c12] border border-[#1b202e] flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div>
            <div class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold">LOCATION & TIMEZONE</div>
            <div class="font-bold text-slate-200">Yogyakarta, Indonesia (UTC+7)</div>
          </div>
          <span class="text-slate-400 text-[10px] border border-[#202534] px-2.5 py-0.5">REMOTE / HYBRID WORLDWIDE</span>
        </div>
      </div>

      <!-- Social & Direct Transmission (5 cols) -->
      <div class="lg:col-span-5 space-y-4 font-mono">
        <!-- Direct Email Transmission Box -->
        <a 
          href="mailto:akinpasha82@gmail.com?subject=Engineering%20Inquiry%20via%20Portfolio" 
          class="p-5 bg-linear-to-r from-[#0d121c] to-[#0a0f18] hover:from-[#131b2b] hover:to-[#0f1624] border border-[#20283d] hover:border-cyan-500/50 block transition-all group"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-cyan-400 flex items-center gap-2">
              <span class="w-2 h-2 bg-cyan-400"></span>
              <span>INITIATE TRANSMISSION</span>
            </span>
            <span class="text-cyan-400 group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Direct dispatch to akinpasha82@gmail.com. Response within 24h for systems architecture, technical leadership, or production AI engineering.
          </p>
        </a>

        <!-- Network Profiles -->
        <div class="grid grid-cols-2 gap-3 text-xs">
          <a 
            href="https://github.com/Akin01" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 bg-[#0a0c12] hover:bg-[#121622] border border-[#1b202e] hover:border-slate-500 text-slate-300 hover:text-white transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>

          <a 
            href="https://linkedin.com/in/ainulyaqin1" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-3 bg-[#0a0c12] hover:bg-[#121622] border border-[#1b202e] hover:border-slate-500 text-slate-300 hover:text-white transition-colors flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66.92 0 1.66-.74 1.66-1.66 0-.92-.74-1.66-1.66-1.66Z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy email interaction
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const emailText = document.getElementById('email-text');

  if (copyBtn && copyText && emailText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(emailText.innerText.trim());
        copyText.innerText = 'COPIED TO CLIPBOARD!';
        copyBtn.classList.remove('bg-cyan-400');
        copyBtn.classList.add('bg-emerald-400');
        setTimeout(() => {
          copyText.innerText = 'COPY EMAIL ADDRESS';
          copyBtn.classList.remove('bg-emerald-400');
          copyBtn.classList.add('bg-cyan-400');
        }, 2000);
      } catch (err) {
        copyText.innerText = 'FAILED TO COPY';
      }
    });
  }
</script>
