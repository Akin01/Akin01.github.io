---
// src/components/Footer.astro
---

<footer class="bg-[#07080d] border-t border-[#202534] py-10 font-mono text-xs text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Top Row -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-[#202534]">
      <div class="font-bold text-slate-200">
        AINUL YAQIN
      </div>

      <!-- Quick Nav Links -->
      <div class="flex flex-wrap items-center gap-5 text-[11px]">
        <a href="#hero" class="hover:text-cyan-400 transition-colors">TOP</a>
        <a href="#terminal" class="hover:text-cyan-400 transition-colors">TERMINAL</a>
        <a href="#architecture" class="hover:text-cyan-400 transition-colors">FOCUS</a>
        <a href="#projects" class="hover:text-cyan-400 transition-colors">PROJECTS</a>
        <a href="#experience" class="hover:text-cyan-400 transition-colors">EXPERIENCE</a>
        <a href="#skills" class="hover:text-cyan-400 transition-colors">STACK</a>
        <a href="#contact" class="hover:text-cyan-400 transition-colors">CONTACT</a>
      </div>

      <!-- External Links -->
      <div class="flex items-center gap-3 text-xs">
        <a 
          href="https://github.com/Akin01" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-cyan-400 transition-colors flex items-center gap-1.5"
        >
          <span>GitHub</span>
        </a>
        <span class="text-slate-700">/</span>
        <a 
          href="https://linkedin.com/in/ainulyaqin1" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hover:text-cyan-400 transition-colors"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Centered Copyright -->
    <div class="text-center text-xs text-slate-400">
      &copy; 2026 Ainul Yaqin.
    </div>

  </div>
</footer>
