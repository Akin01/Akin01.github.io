---
// src/components/GsapAnimations.astro
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  // 1. Initialize Lenis Smooth Scroll Engine
  const lenis = new Lenis({
    duration: 1.15,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smoothWheel: true,
    wheelMultiplier: 1.0,
    touchMultiplier: 1.5,
  });

  // 2. Synchronize Lenis with GSAP ScrollTrigger
  lenis.on('scroll', ScrollTrigger.update);

  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  gsap.ticker.lagSmoothing(0);

  // 3. Smooth in-page anchor navigation via Lenis
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (href && href.startsWith('#') && href.length > 1) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          lenis.scrollTo(target as HTMLElement, { offset: -64 });
        }
      }
    });
  });

  function initAnimations() {
    // Hero Entrance
    const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });

    tl.fromTo('#main-nav', 
      { y: -30, opacity: 0 }, 
      { y: 0, opacity: 1, duration: 0.4, clearProps: 'transform,opacity' }
    )
    .fromTo('.hero-portrait', 
      { y: 20, opacity: 0 }, 
      { y: 0, opacity: 1, duration: 0.55, clearProps: 'transform,opacity' }, 
      '-=0.15'
    )
    .fromTo('.hero-caption', 
      { y: 20, opacity: 0 }, 
      { y: 0, opacity: 1, duration: 0.55, clearProps: 'transform,opacity' }, 
      '-=0.4'
    )
    .fromTo('.hero-actions > *', 
      { y: 10, opacity: 0 }, 
      { y: 0, opacity: 1, duration: 0.35, stagger: 0.06, clearProps: 'transform,opacity' }, 
      '-=0.2'
    );

    // Terminal Section (Lightweight Fade)
    gsap.fromTo('#terminal > div',
      { opacity: 0, y: 15 },
      {
        opacity: 1,
        y: 0,
        duration: 0.45,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: '#terminal',
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      }
    );

    // Architecture Focus Section
    gsap.fromTo('#architecture-carousel',
      { opacity: 0, y: 15 },
      {
        opacity: 1,
        y: 0,
        duration: 0.45,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: '#architecture',
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      }
    );

    // Skills Matrix & Education
    gsap.fromTo('#skills .grid > div',
      { opacity: 0, y: 15 },
      {
        opacity: 1,
        y: 0,
        duration: 0.45,
        stagger: 0.06,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: '#skills',
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      }
    );

    // Contact Section
    gsap.fromTo('#contact > div',
      { opacity: 0, y: 15 },
      {
        opacity: 1,
        y: 0,
        duration: 0.45,
        ease: 'power2.out',
        clearProps: 'transform,opacity',
        scrollTrigger: {
          trigger: '#contact',
          start: 'top 85%',
          toggleActions: 'play none none none',
        }
      }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }

  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
  });
</script>
