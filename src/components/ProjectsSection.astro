                      <span class={`px-2 py-0.5 text-[10px] font-mono font-bold tracking-wider uppercase border ${badgeColor}`}>
                        {proj.badge}
                      </span>

                      {proj.stars && (
                        <div class="flex items-center gap-1 font-mono text-xs text-amber-300 bg-[#1c1810] px-2 py-0.5 border border-[#382d18]">
                          <span>★</span>
                          <span class="font-bold">{proj.stars}</span>
                        </div>
                      )}
                    </div>

                    <!-- Real README / Web Screenshot Preview -->
                    <div class="relative w-full flex-1 aspect-16/10 max-h-60 sm:max-h-65 bg-black border border-[#202636] overflow-hidden shrink-0">
                      <img 
                        src={proj.image} 
                        alt={`${proj.title} README`}
                        class="w-full h-full object-cover object-top pointer-events-none" 
                        loading="lazy" 
                        decoding="async"
                        draggable="false"
                      />
                    </div>

                    <!-- Title, Engine & SPECS Trigger Button -->
                    <div class="flex items-center justify-between pt-1 shrink-0">
                      <div>
                        <h3 class="text-lg sm:text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">
                          {proj.title}
                        </h3>
                        <div class="font-mono text-[11px] text-slate-400 mt-0.5">
                          Engine: <span class="text-cyan-400 font-semibold">{proj.lang}</span>
                        </div>
                      </div>

