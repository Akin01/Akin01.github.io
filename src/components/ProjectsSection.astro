                        <span class={`px-2 py-0.5 text-[10px] font-mono font-bold tracking-wider uppercase border ${badgeColor}`}>
                          {proj.badge}
                        </span>
                        {proj.stars && (
                          <span class="px-2 py-0.5 text-xs font-mono text-amber-300 bg-[#1c1810] border border-[#382d18]">★ {proj.stars}</span>
                        )}
                      </div>
                    </div>

                    <!-- Title & Description -->
                    <div class="space-y-1.5 py-1 shrink-0 font-mono">
                      <h3 class="text-base sm:text-lg font-bold text-white">
                        {proj.title}
                      </h3>
                      <p class="text-xs text-slate-300 font-sans leading-relaxed">
                        {proj.description}
                      </p>
                    </div>

                    <!-- Architecture Spec Callout -->
                    <div class="space-y-1 font-mono bg-[#090b10] p-2.5 border border-[#1b212f] shrink-0">
                      <div class="text-cyan-400 text-[10px] uppercase font-bold tracking-wider">
                        // ARCHITECTURE SPEC
                      </div>
                      <p class="text-slate-300 font-sans text-[11px] leading-relaxed">
                        {proj.architectureHighlight}
                      </p>
                    </div>

                    <!-- Tags -->
                    <div class="flex flex-wrap gap-1 font-mono text-[10px] shrink-0">
                      {proj.tags.map(t => (
                        <span class="px-2 py-0.5 bg-[#141824] border border-[#222a3d] text-slate-300">
                          {t}
                        </span>
                      ))}
                    </div>

                    <!-- Footer Links -->
                    <div class="pt-2 border-t border-[#202534] flex items-center justify-between text-xs font-mono shrink-0">
                      <span class="text-[10px] text-slate-400 font-medium">{proj.metrics || ''}</span>
                      <div class="flex items-center gap-3">
                        {proj.githubUrl && (
                          <a href={proj.githubUrl} target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-cyan-400 font-bold flex items-center gap-1 transition-colors pointer-events-auto">
                            <span>View Code</span>
                            <span>&rarr;</span>
                          </a>
                        )}
                        {proj.liveUrl && (
                          <a href={proj.liveUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-bold flex items-center gap-1 transition-colors pointer-events-auto">
                            <span>Live App</span>
                            <span>&rarr;</span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Bottom Button / Line Arrow to Advance (Click to advance, or drag card) -->
          <button 
            type="button"
            id="swipe-instruction-arrow"
            class="flex items-center justify-center gap-3 mt-6 font-mono text-xs select-none cursor-pointer group bg-transparent border-none outline-none hover:text-white transition-colors"
            title="Click to advance next project or swipe card"
          >
            <span class="text-slate-400 text-xs font-semibold group-hover:text-cyan-400 transition-colors">// DRAG OR SWIPE</span>
            <div class="flex items-center">
              <span class="inline-block w-20 sm:w-28 h-px bg-cyan-400 group-hover:w-32 transition-all"></span>
              <svg class="w-4 h-4 text-cyan-400 -ml-1 inline-block transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
            <span class="text-cyan-400 font-bold text-xs uppercase tracking-wider group-hover:text-cyan-300">NEXT PROJECT &rarr;</span>
          </button>
        </div>

        <!-- Right: Unbordered Desktop Specifications Panel (Retained for Desktop Split-Screen) -->
        <div id="details-column" class="hidden lg:col-span-7 opacity-0 will-change-transform">
          <div class="p-2 sm:p-5 space-y-5" id="project-details-card">
            <!-- Dynamic project specifications populated on desktop card click -->
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

