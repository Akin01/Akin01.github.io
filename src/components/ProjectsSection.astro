  let visibleCards: HTMLElement[] = [];
  let currentCardIndex = 0;
  let isSwiping = false;
  let isPointerInteracting = false;
  let isSectionVisible = false;

  function startAutoSwipe() {
    stopAutoSwipe();
    if (!isSectionVisible) return;
    autoSwipeTimer = setInterval(() => {
      if (isDesktopSplitOpen || isMobileDetailOpen || isPointerInteracting || isSwiping || document.hidden || !isSectionVisible) return;
      magicSwipeNext();
    }, AUTO_SWIPE_INTERVAL);
  }

  function stopAutoSwipe() {
    if (autoSwipeTimer) {
      clearInterval(autoSwipeTimer);
      autoSwipeTimer = null;
    }
  }

  function resetAutoSwipe() {
    if (isSectionVisible) startAutoSwipe();
  }

  // --- MOBILE BEHAVIOR: In-Card Slide Transition (Detail stays on the card) ---
  function toggleMobileCardDetail(card: HTMLElement, forceOpen?: boolean) {
    const frontFace = card.querySelector('.card-face-front') as HTMLElement | null;
    const detailFace = card.querySelector('.card-face-detail') as HTMLElement | null;
    if (!frontFace || !detailFace) return;

    const shouldOpen = forceOpen !== undefined ? forceOpen : !isMobileDetailOpen;
    isMobileDetailOpen = shouldOpen;

    if (shouldOpen) {
      gsap.to(card, { rotation: 0, duration: 0.22, ease: 'power2.out' });
      gsap.to(frontFace, { x: '-100%', opacity: 0, duration: 0.22, ease: 'power2.out' });
      detailFace.style.pointerEvents = 'auto';
      gsap.fromTo(detailFace, 
        { x: '100%', opacity: 0 },
        { x: '0%', opacity: 1, duration: 0.24, ease: 'power2.out' }
      );
    } else {
      startAutoSwipe();
      const angle = parseFloat(card.getAttribute('data-angle') || '0');
      gsap.to(card, { rotation: angle * 0.4, duration: 0.2, ease: 'power2.out' });
      detailFace.style.pointerEvents = 'none';
      gsap.to(detailFace, { x: '100%', opacity: 0, duration: 0.2, ease: 'power2.in' });
      gsap.fromTo(frontFace,
        { x: '-100%', opacity: 0 },
        { x: '0%', opacity: 1, duration: 0.22, ease: 'power2.out' }
      );
    }
  }

  function resetAllMobileCardDetails() {
    isMobileDetailOpen = false;
    visibleCards.forEach(c => {
      const front = c.querySelector('.card-face-front') as HTMLElement | null;
      const detail = c.querySelector('.card-face-detail') as HTMLElement | null;
      if (front) gsap.set(front, { x: '0%', opacity: 1 });
      if (detail) {
        detail.style.pointerEvents = 'none';
        gsap.set(detail, { x: '100%', opacity: 0 });
      }
    });
  }

  // --- DESKTOP BEHAVIOR: Retained Split-Screen Layout (Moves deck left, opens unbordered panel right) ---
  function renderDesktopDetailsPanel(data: typeof projectsData[0]) {
    if (!detailsCard) return;

    const badgeColor = data.badgeType === 'pinned'
      ? 'bg-[#0e1922] text-cyan-300 border-[#1c384a]'
      : data.badgeType === 'package'
      ? 'bg-[#1c1810] text-amber-300 border-[#382d18]'
      : 'bg-[#0f1d17] text-emerald-300 border-[#193a2b]';

    detailsCard.innerHTML = `
      <div class="flex items-center justify-between pb-3 border-b border-[#202534]">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 text-[10px] font-mono font-bold tracking-wider uppercase border ${badgeColor}">
            ${data.badge}
          </span>
          ${data.stars ? `<span class="px-2 py-0.5 text-xs font-mono text-amber-300 bg-[#1c1810] border border-[#382d18]">★ ${data.stars}</span>` : ''}
        </div>
      </div>

      <div>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
          ${data.title}
        </h3>
        <div class="font-mono text-xs text-slate-400 mt-1">
          Engine: <span class="text-cyan-400 font-semibold">${data.lang}</span>
        </div>
      </div>

      <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-sans">
        ${data.description}
      </p>

      <div class="space-y-1.5 font-mono">
        <div class="text-cyan-400 text-xs uppercase font-bold tracking-wider">
          // ARCHITECTURE SPEC
        </div>
        <p class="text-slate-300 font-sans text-xs sm:text-sm leading-relaxed">
          ${data.architectureHighlight}
        </p>
      </div>

      <div class="flex flex-wrap gap-1.5 pt-1 font-mono text-xs">
        ${data.tags.map(t => `<span class="px-2.5 py-0.5 bg-[#141824] border border-[#222a3d] text-slate-300 text-[11px]">${t}</span>`).join('')}
      </div>

      <div class="pt-4 border-t border-[#202534] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
        <span class="text-[11px] text-slate-400 font-medium">${data.metrics || ''}</span>
        <div class="flex items-center gap-3">
          ${data.githubUrl ? `
            <a href="${data.githubUrl}" target="_blank" rel="noopener noreferrer" class="text-slate-300 hover:text-cyan-400 font-bold flex items-center gap-1 transition-colors">
              <span>View Code</span>
              <span>&rarr;</span>
            </a>` : ''
          }
          ${data.liveUrl ? `
            <a href="${data.liveUrl}" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 font-bold flex items-center gap-1 transition-colors">
              <span>Live App</span>
              <span>&rarr;</span>
            </a>` : ''
          }
        </div>
      </div>
    `;
  }

  function openDesktopDetailsMode() {
    if (isDesktopSplitOpen) return;
    isDesktopSplitOpen = true;
    stopAutoSwipe();
    const currentCard = visibleCards[currentCardIndex];
    if (!currentCard) return;
    const dataIndex = parseInt(currentCard.getAttribute('data-card-index') || '0', 10);
    const data = projectsData[dataIndex];
    renderDesktopDetailsPanel(data);

    if (deckColumn && detailsColumn) {
      deckColumn.classList.remove('lg:col-span-12', 'items-center');
      deckColumn.classList.add('lg:col-span-5', 'lg:items-start');

      detailsColumn.classList.remove('hidden');
      gsap.fromTo(detailsColumn, 
        { opacity: 0, x: 15 },
        { opacity: 1, x: 0, duration: 0.22, ease: 'power2.out' }
      );
    }

    layoutDeck();
  }

  function closeDesktopDetailsMode() {
    if (!isDesktopSplitOpen) return;
    isDesktopSplitOpen = false;
    startAutoSwipe();
    if (detailsColumn && deckColumn) {
      // 1. Immediately re-center the deck with zero delay
      deckColumn.classList.remove('lg:col-span-5', 'lg:items-start');
      deckColumn.classList.add('lg:col-span-12', 'items-center');
      layoutDeck();

      // 2. Concurrently fade out the details panel quickly
      gsap.to(detailsColumn, {
        opacity: 0,
        duration: 0.15,
        ease: 'power2.in',
        onComplete: () => {
          detailsColumn.classList.add('hidden');
        }
      });
    }
  }

  // Visual 3-Stack Display (Card 1 Front, Card 2 Middle, Card 3 Back)
  function layoutDeck() {
    if (visibleCards.length === 0) return;

    visibleCards.forEach((card, idx) => {
      const angle = parseFloat(card.getAttribute('data-angle') || '0');
      const diff = (idx - currentCardIndex + visibleCards.length) % visibleCards.length;

      // Attach pointer listener to front card
      attachCardEvents(card, diff === 0);

      if (diff === 0) {
        // Card 1: Front Spotlight
        gsap.to(card, {
          x: 0,
          y: 0,
          rotation: isDesktopSplitOpen || isMobileDetailOpen ? 0 : angle * 0.4,
          scale: 1,
          opacity: 1,
          zIndex: 30,
          duration: 0.28,
          ease: 'power2.out',
        });
        card.style.pointerEvents = 'auto';
      } else if (diff === 1) {
        // Card 2: Middle of 3-stack (Increased overflow to the right)
        gsap.to(card, {
          x: isDesktopSplitOpen ? -35 : 70,
          y: isDesktopSplitOpen ? 18 : -18,
          rotation: isDesktopSplitOpen ? 1.8 : angle * 1.6,
          scale: 0.93,
          opacity: 0.84,
          zIndex: 20,
          duration: 0.28,
          ease: 'power2.out',
        });
        card.style.pointerEvents = 'none';
      } else if (diff === 2) {
        // Card 3: Back of 3-stack (Increased overflow to the left)
        gsap.to(card, {
          x: isDesktopSplitOpen ? -62 : -60,
          y: isDesktopSplitOpen ? 32 : -30,
          rotation: isDesktopSplitOpen ? 3.4 : -angle * 2.0,
          scale: 0.86,
          opacity: 0.68,
          zIndex: 10,
          duration: 0.30,
          ease: 'power2.out',
        });
        card.style.pointerEvents = 'none';
      } else {
        // Deeper cards hidden behind with subtle upper peek
        gsap.to(card, {
          x: 0,
          y: -42,
          rotation: angle,
          scale: 0.80,
          opacity: 0,
          zIndex: 1,
          duration: 0.25,
          overwrite: 'auto'
        });
        card.style.pointerEvents = 'none';
      }
    });
  }

  // Magic Card Swipe Next (Advances to next project in deck)
  function magicSwipeNext() {
    if (isSwiping || visibleCards.length <= 1) return;
    isSwiping = true;
    setTimeout(() => { isSwiping = false; }, 320);
    resetAutoSwipe();
    resetAllMobileCardDetails();

    const currentCard = visibleCards[currentCardIndex];
    if (!currentCard) {
      isSwiping = false;
      return;
    }
    const angle = parseFloat(currentCard.getAttribute('data-angle') || '0');

    // 1. Current card magically sweeps off to the right
    gsap.to(currentCard, {
      x: 520,
      y: -25,
      rotation: angle + 25,
      duration: 0.26,
      ease: 'power3.in',
      onComplete: () => {
        currentCardIndex = (currentCardIndex + 1) % visibleCards.length;

        // Reset the swiped card behind the stack
        gsap.set(currentCard, {
          x: 0,
          y: -35,
          rotation: angle,
          scale: 0.8,
          opacity: 0,
          zIndex: 1
        });

        if (isDesktopSplitOpen) {
          const nextDataIndex = parseInt(visibleCards[currentCardIndex].getAttribute('data-card-index') || '0', 10);
          renderDesktopDetailsPanel(projectsData[nextDataIndex]);
        }

        layoutDeck();
        isSwiping = false;
      }
    });

    // 2. Next card steps into spotlight
    const nextIndex = (currentCardIndex + 1) % visibleCards.length;
    const nextCard = visibleCards[nextIndex];
    if (nextCard) {
      gsap.to(nextCard, {
        x: 0,
        y: 0,
        rotation: isDesktopSplitOpen ? 0 : parseFloat(nextCard.getAttribute('data-angle') || '0') * 0.4,
        scale: 1,
        opacity: 1,
        zIndex: 30,
        duration: 0.28,
        ease: 'power2.out'
      });
    }
  }

  // Pointer & Drag Interaction on Front Card
  function attachCardEvents(card: HTMLElement, isFront: boolean) {
    if (!isFront) {
      card.onpointerdown = null;
      card.onpointermove = null;
      card.onpointerup = null;
      card.onpointercancel = null;
      return;
    }
    // Attach click listeners to SPECS button
    const specsBtn = card.querySelector('.card-specs-btn');
    if (specsBtn) {
      specsBtn.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        const isMobile = window.innerWidth < 1024;
        if (isMobile) {
          toggleMobileCardDetail(card, true);
        } else {
          openDesktopDetailsMode();
        }
      });
    }

    // Attach click listener to mobile PREVIEW button
    const backBtn = card.querySelector('.card-preview-back-btn');
    if (backBtn) {
      backBtn.addEventListener('click', (e: Event) => {
        e.stopPropagation();
        toggleMobileCardDetail(card, false);
      });
    }
    let startX = 0;
    let startY = 0;
    let deltaX = 0;
    let isDown = false;
    let isDraggingCard = false;

    card.onpointerdown = (e: PointerEvent) => {
      // Ignore click on links or interactive buttons inside the card
      if ((e.target as HTMLElement)?.closest('a, button')) return;

      isDown = true;
      isDraggingCard = false;
      startX = e.clientX;
      startY = e.clientY;
      deltaX = 0;
    };

    card.onpointermove = (e: PointerEvent) => {
      if (!isDown) return;
      
      const diffX = e.clientX - startX;
      const diffY = e.clientY - startY;

      // Vertical vs Horizontal gesture discernment:
      // If moving vertically, user is scrolling the page -> immediately release card and allow 100% native smooth scroll!
      if (!isDraggingCard) {
        if (Math.abs(diffY) > Math.abs(diffX) && Math.abs(diffY) > 5) {
          isDown = false;
          return;
        }
        if (Math.abs(diffX) > 8 && Math.abs(diffX) > Math.abs(diffY)) {
          isDraggingCard = true;
          isPointerInteracting = true;
          stopAutoSwipe();
          try { card.setPointerCapture(e.pointerId); } catch (_) {}
        }
      }

      if (isDraggingCard) {
        deltaX = diffX;
        gsap.set(card, {
          x: deltaX,
          rotation: deltaX * 0.04,
          ease: 'none'
        });
      }
    };

    card.onpointerup = (e: PointerEvent) => {
      if (!isDown && !isDraggingCard) return;
      const wasDragging = isDraggingCard;
      isDown = false;
      isDraggingCard = false;
      isPointerInteracting = false;
      resetAutoSwipe();
      try { card.releasePointerCapture(e.pointerId); } catch (_) {}

      if (wasDragging && Math.abs(deltaX) > 30) {
        // Swiped past threshold -> trigger magic swipe!
        magicSwipeNext();
      } else if (!wasDragging && Math.abs(deltaX) <= 8) {
        // Clean Click without drag!
        const isMobile = window.innerWidth < 1024;
        if (isMobile) {
          toggleMobileCardDetail(card);
        } else {
          if (!isDesktopSplitOpen) {
            openDesktopDetailsMode();
          } else {
            closeDesktopDetailsMode();
          }
        }
      } else {
        // Snaps back
        const angle = parseFloat(card.getAttribute('data-angle') || '0');
        gsap.to(card, {
          x: 0,
          rotation: (isDesktopSplitOpen || isMobileDetailOpen) ? 0 : angle * 0.4,
          duration: 0.22,
          ease: 'power2.out'
        });
      }
    };

    card.onpointercancel = () => {
      isDown = false;
      isDraggingCard = false;
      isPointerInteracting = false;
      resetAutoSwipe();
      const angle = parseFloat(card.getAttribute('data-angle') || '0');
      gsap.to(card, {
        x: 0,
        rotation: (isDesktopSplitOpen || isMobileDetailOpen) ? 0 : angle * 0.4,
        duration: 0.22,
        ease: 'power2.out'
      });
    };
  }

  // Init
  visibleCards = Array.from(document.querySelectorAll<HTMLElement>('.magic-card'));
  layoutDeck();

  // Observe section visibility so auto-swipe only runs when in viewport
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      isSectionVisible = entry.isIntersecting;
      if (entry.isIntersecting) {
        if (!isDesktopSplitOpen && !isMobileDetailOpen) startAutoSwipe();
      } else {
        stopAutoSwipe();
      }
    });
  }, { threshold: 0.15 });

  const projectsSection = document.getElementById('projects');
  if (projectsSection) sectionObserver.observe(projectsSection);
  // Pause auto-swipe on hover, resume on leave
  if (stageWrapper) {
    stageWrapper.addEventListener('mouseenter', stopAutoSwipe);
    stageWrapper.addEventListener('mouseleave', () => {
      if (!isDesktopSplitOpen && !isMobileDetailOpen && !isPointerInteracting) startAutoSwipe();
    });
  }

  // Advance to next card via bottom button
  if (nextButton) {
    nextButton.addEventListener('click', (e) => {
      e.preventDefault();
      magicSwipeNext();
    });
  }

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
      magicSwipeNext();
    } else if (e.key === 'Escape') {
      if (isDesktopSplitOpen) {
        closeDesktopDetailsMode();
      }
      const currentCard = visibleCards[currentCardIndex];
      if (currentCard && isMobileDetailOpen) {
        toggleMobileCardDetail(currentCard, false);
      }
    }
  });
</script>
