                      <button 
                        type="button" 
                        class="card-preview-back-btn flex items-center gap-1.5 text-cyan-400 hover:text-cyan-300 font-mono text-xs font-bold py-1 px-2.5 border border-[#202534] bg-[#121622] hover:border-cyan-500/50 transition-colors pointer-events-auto cursor-pointer"
