              const badgeColor = proj.badgeType === 'org' 
                ? 'bg-[#1e1318] text-rose-300 border-[#3d202e]' 
                : proj.badgeType === 'pinned'
                ? 'bg-[#0e1922] text-cyan-300 border-[#1c384a]'
                : proj.badgeType === 'package'
                ? 'bg-[#1c1810] text-amber-300 border-[#382d18]'
                : 'bg-[#0f1d17] text-emerald-300 border-[#193a2b]';

              return (
                <article 
                  class="magic-card absolute top-0 left-0 w-full h-full flat-panel p-5 sm:p-6 border border-[#262c3e] bg-[#0c0e16]/90 backdrop-blur-sm shadow-2xl cursor-pointer select-none overflow-hidden"
                  data-category={proj.category}
                  data-pinned={proj.badgeType === "org" || proj.badgeType === "pinned" || proj.badgeType === "package" ? "true" : "false"}
                  data-angle={proj.angle}
                  data-card-index={idx}
                  style={`--init-angle: ${proj.angle}deg; transform: rotate(${proj.angle}deg); touch-action: pan-y; user-select: none;`}
                >
                  <!-- Card Face: FRONT (Preview View) -->
                  <div class="card-face-front w-full h-full flex flex-col justify-between space-y-3 pointer-events-none will-change-transform">
