<section class="py-20 bg-[#07080d] border-b border-[#202534] overflow-x-clip" id="projects">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Prefix title only, no big title, no divider) -->
    <div class="mb-8">
      <h2 class="font-mono text-xs sm:text-sm text-cyan-400 tracking-widest font-semibold uppercase">
        // PINNED PROJECTS & DELIVERABLES
      </h2>
    </div>

    <!-- Stage Grid: Centered by default; on desktop, moves to lg:col-span-5 and opens unbordered details on lg:col-span-7 -->
