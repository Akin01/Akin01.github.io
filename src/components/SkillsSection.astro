---
// src/components/SkillsSection.astro

const leftBranches = [
  {
    title: "LANGUAGES & RUNTIMES",
    prefix: "├──",
    skills: [
      { name: "Rust", detail: "Tokio, Tauri v2, Axum, Actix" },
      { name: "TypeScript", detail: "Deno, Node.js, Bun, SolidJS, Nextjs, Astro" },
      { name: "Go", detail: "Concurrency, Fiber, Chi" },
      { name: "Python", detail: "PyTorch, FastAPI, MLOps" },
      { name: "Java", detail: "Spring, Enterprise Backend" },
      { name: "SQL", detail: "MySQL, Postgresql, DuckDB, D1" }
    ]
  },
  {
    title: "SYSTEMS & NETWORKING",
    prefix: "├──",
    skills: [
      { name: "Raw TCP & Protocols", detail: "MessagePack binary frames" },
      { name: "WebSockets & SSE", detail: "Real-time streaming feeds" },
      { name: "Query Optimization", detail: "EXPLAIN, indexing, appropriate data types" },
      { name: "Observability", detail: "OpenTelemetry tracing" },
      { name: "Containers", detail: "Docker, Kubernetes, Lambda, Cloudrun, Workers" }
    ]
  }
];

const rightBranches = [
  {
    title: "APPLIED AI & MLOPS",
    prefix: "├──",
    skills: [
      { name: "RAG & Vector Search", detail: "Auditable corporate retrieval" },
      { name: "Schema Validation", detail: "Deterministic LLM JSON output" },
      { name: "Deep Learning", detail: "PyTorch, LSTM time-series" },
      { name: "Cloud MLOps", detail: "GCP Stack, AWS" },
      { name: "Probabilistic ML", detail: "N-gram Markov chains" }
    ]
  },
  {
    title: "SPATIAL & CLOUD EDGE",
    prefix: "└──",
    skills: [
      { name: "WebGL & MapLibre GL", detail: "60 FPS GPU spatial rendering" },
      { name: "Web Workers", detail: "Decoupled compute threads" },
      { name: "Cloudflare Edge", detail: "Workers, D1, Durable Objects" },
      { name: "AWS Infrastructure", detail: "Well-Architected, Serverless" }
    ]
  }
];

const certifications = [
  {
    title: "Kotlin Professional Certificate",
    issuer: "JetBrains",
    year: "2026",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Develop Your Rust Skills for Data Engineering",
    issuer: "LinkedIn Learning",
    year: "2026",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Complete Guide to AWS Well-Architected Framework",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Certified Kubernetes Security Specialist (CKS) Prep",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Advance Your AWS Development Skills: Complex App Dev",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Master Retrieval-Augmented Generation (RAG)",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Become an AI Engineer",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Deploying Machine Learning Models in Production",
    issuer: "DeepLearning.AI",
    year: "2021",
    url: "https://www.coursera.org/account/accomplishments/certificate/LRAVYYA59JSU"
  },
  {
    title: "Practical Data Science Specialization",
    issuer: "DeepLearning.AI",
    year: "2022",
    url: "https://www.coursera.org/account/accomplishments/specialization/certificate/7HRMALFAJ6FG"
  },
  {
    title: "DevOps on AWS Specialization",
    issuer: "Amazon Web Services (AWS)",
    year: "2022",
    url: "https://www.coursera.org/account/accomplishments/specialization/certificate/S5927FFA22MW"
  },
  {
    title: "Data Engineering Foundations Professional",
    issuer: "Astronomer",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  },
  {
    title: "Serverless Web App Development on AWS",
    issuer: "LinkedIn Learning",
    year: "2025",
    url: "https://www.linkedin.com/in/ainulyaqin1/details/certifications/"
  }
];
---

<section class="py-20 bg-[#07080d] border-b border-[#202534]" id="skills">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (Clean // prefix, no big title, no divider) -->
    <div class="mb-10">
      <h2 class="font-mono text-xs sm:text-sm text-cyan-400 tracking-widest font-semibold uppercase">
        // TECHNICAL MATRIX & CAPABILITIES
      </h2>
    </div>

    <!-- Unbroken Tree Abstract Layout (2 Columns, Single-Line Connected Nodes, Overflow-Protected) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 pb-14 border-b border-[#1c2230] font-mono text-xs">
      
      <!-- Left Tree Branch -->
      <div class="font-mono overflow-x-auto scrollbar-none pb-2">
        <div class="min-w-120 lg:min-w-0 space-y-6">
          {leftBranches.map((cat) => (
            <div class="space-y-1">
              <!-- Group Header Node -->
              <div class="text-xs text-cyan-400 font-bold tracking-wider flex items-center gap-2 pb-1.5 border-b border-[#1c2230] pt-2">
                <span class="text-slate-500 font-mono select-none whitespace-pre">{cat.prefix}</span>
                <span>{cat.title}</span>
              </div>

              <!-- Children with continuous vertical tree connector line -->
              <ul class="space-y-1.5 py-2">
                {cat.skills.map((s, idx) => {
                  const isLast = idx === cat.skills.length - 1;
                  return (
                    <li class="flex items-center justify-between gap-2 text-xs py-0.5 group">
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="text-slate-600 font-mono select-none whitespace-pre">
                          {'│   '}{isLast ? '└── ' : '├── '}
                        </span>
                        <span class="font-bold text-white group-hover:text-cyan-300 transition-colors font-mono">{s.name}</span>
                      </div>
                      <div class="flex-1 border-b border-dotted border-[#22293a] mx-2"></div>
                      <span class="text-slate-400 text-[11px] shrink-0 font-mono">{s.detail}</span>
                    </li>
                  );
                })}
              </ul>

              <!-- Connecting trunk line between groups -->
              <div class="text-slate-600 font-mono select-none whitespace-pre text-xs py-0.5 pl-0.5">
                │
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Tree Branch -->
      <div class="font-mono overflow-x-auto scrollbar-none pb-2">
        <div class="min-w-120 lg:min-w-0 space-y-6">
          {rightBranches.map((cat, groupIdx) => (
            <div class="space-y-1">
              <!-- Group Header Node -->
              <div class="text-xs text-cyan-400 font-bold tracking-wider flex items-center gap-2 pb-1.5 border-b border-[#1c2230] pt-2">
                <span class="text-slate-500 font-mono select-none whitespace-pre">{cat.prefix}</span>
                <span>{cat.title}</span>
              </div>

              <!-- Children with continuous vertical tree connector line -->
              <ul class="space-y-1.5 py-2">
                {cat.skills.map((s, idx) => {
                  const isLast = idx === cat.skills.length - 1;
                  return (
                    <li class="flex items-center justify-between gap-2 text-xs py-0.5 group">
                      <div class="flex items-center gap-2 shrink-0">
                        <span class="text-slate-600 font-mono select-none whitespace-pre">
                          {'│   '}{isLast ? '└── ' : '├── '}
                        </span>
                        <span class="font-bold text-white group-hover:text-cyan-300 transition-colors font-mono">{s.name}</span>
                      </div>
                      <div class="flex-1 border-b border-dotted border-[#22293a] mx-2"></div>
                      <span class="text-slate-400 text-[11px] shrink-0 font-mono">{s.detail}</span>
                    </li>
                  );
                })}
              </ul>

              <!-- Connecting trunk line between groups -->
              {groupIdx === 0 && (
                <div class="text-slate-600 font-mono select-none whitespace-pre text-xs py-0.5 pl-0.5">
                  │
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Minimalist Education & Certifications Row (Tree Styled with Logos and Redirect Links) -->
    <div class="pt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start font-mono">
      
      <!-- Education (5 cols) -->
      <div class="lg:col-span-5 space-y-4 font-mono">
        <div class="text-xs text-cyan-400 uppercase tracking-widest font-semibold pb-1.5 border-b border-[#1c2230] flex items-center gap-2">
          <span class="text-slate-500 font-mono select-none whitespace-pre">├──</span>
          <span>EDUCATION</span>
        </div>
        
        <div class="space-y-4 text-xs font-mono">
          <!-- UGM -->
          <a
            href="https://ugm.ac.id"
            target="_blank"
            rel="noopener noreferrer"
            class="block space-y-1 pb-3 border-b border-[#151924] group/edu hover:border-cyan-500/40 transition-colors"
          >
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-bold text-white flex items-center gap-2 group-hover/edu:text-cyan-300 transition-colors">
                <span class="text-slate-600 font-mono select-none whitespace-pre">│   ├── </span>
                <!-- UGM Official Line Emblem from ugm.ac.id -->
                <img src="/ugm_logo.webp" alt="Universitas Gadjah Mada" class="w-3.5 h-3.5 object-contain shrink-0" />
                <span>Universitas Gadjah Mada (UGM)</span>
                <svg class="w-2.5 h-2.5 opacity-0 group-hover/edu:opacity-100 text-cyan-400 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </span>
              <span class="text-slate-400 text-[11px] shrink-0 font-mono">2019 — 2026</span>
            </div>
            <div class="text-cyan-300 font-semibold pl-10 text-xs">Engineering Physics (B.Eng)</div>
            <p class="text-slate-400 font-mono text-[11px] leading-relaxed pl-10 pt-0.5">
              Yogyakarta, ID. Mathematical physics, signal processing, thermodynamics, computational modeling, and instrumentation systems.
            </p>
          </a>

          <!-- Binar Academy -->
          <a
            href="https://www.binaracademy.com"
            target="_blank"
            rel="noopener noreferrer"
            class="block space-y-1 group/edu hover:border-cyan-500/40 transition-colors"
          >
            <div class="flex items-baseline justify-between gap-2">
              <span class="font-bold text-white flex items-center gap-2 group-hover/edu:text-cyan-300 transition-colors">
                <span class="text-slate-600 font-mono select-none whitespace-pre">│   └── </span>
                <!-- Binar Academy Official Vector Mark from binar.co.id -->
                <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/edu:text-cyan-300" viewBox="0 0 43 49" fill="currentColor">
                  <path d="M8.566 8.406C5.175 11.061 2.608 14.709 1.313 18.915 18.789 30.372 19.755 45.126 19.806 46.373c.517.047 1.04.072 1.565.083C23.466 21.509 12.35 11.165 8.566 8.406Z" opacity="0.8"/>
                  <path d="M.44 23.695c-.04.52-.065 1.043-.065 1.571 0 10.777 8.99 19.682 19.429 21.105-4.259-13.88-15.044-20.403-19.364-22.676Z"/>
                  <path d="M34.065 8.406c3.391 2.655 5.959 6.303 7.254 10.509-17.477 11.456-18.443 26.21-18.494 27.458-.517.047-1.039.072-1.565.083-2.096-24.948 9.023-35.292 12.805-38.05Z"/>
                  <path d="M42.185 23.588c.039.52.064 1.042.064 1.57 0 10.778-8.99 19.791-19.429 21.214 4.259-13.883 15.044-20.512 19.365-22.784Z" opacity="0.8"/>
                  <path d="M14.39 5.44C17.855 6.424 20.55 9.25 21.316 12.782V3.85C18.832 3.847 16.484 4.423 14.39 5.44Z"/>
                  <path d="M21.313 3.848v8.932c.767-3.533 3.461-6.361 6.924-7.342-2.09-1.015-4.441-1.59-6.924-1.59Z"/>
                </svg>
                <span>Binar Academy X BCA</span>
                <svg class="w-2.5 h-2.5 opacity-0 group-hover/edu:opacity-100 text-cyan-400 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7V17"/>
                </svg>
              </span>
              <span class="text-slate-400 text-[11px] shrink-0 font-mono">2023 — 2024</span>
            </div>
            <div class="text-cyan-300 font-semibold pl-10 text-xs">Backend Java Engineering</div>
            <p class="text-slate-400 font-mono text-[11px] leading-relaxed pl-10 pt-0.5">
              Enterprise backend architecture, Java ecosystem, Spring Framework, scalable API patterns, and relational data modeling.
            </p>
          </a>
        </div>
      </div>

      <!-- Certifications (7 cols with Redirect Links and Institution Logos) -->
      <div class="lg:col-span-7 space-y-4 font-mono">
        <div class="text-xs text-cyan-400 uppercase tracking-widest font-semibold pb-1.5 border-b border-[#1c2230] flex items-center gap-2">
          <span class="text-slate-500 font-mono select-none whitespace-pre">└──</span>
          <span>VERIFIED CERTIFICATIONS & LICENSES</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2.5 text-xs">
          {certifications.map((cert, idx) => {
            const isLast = idx >= certifications.length - 2;
            return (
              <a
                href={cert.url}
                target="_blank"
                rel="noopener noreferrer"
                title={`View verified credential: ${cert.title}`}
                class="flex items-baseline justify-between gap-2 py-1.5 border-b border-[#151924] group/cert hover:border-cyan-500/40 transition-colors"
              >
                <div class="flex items-baseline gap-2 truncate">
                  <span class="text-slate-600 font-mono select-none whitespace-pre">{isLast ? '    └── ' : '    ├── '}</span>
                  <div class="truncate">
                    <!-- Institution Issuer with Logo -->
                    <div class="flex items-center gap-1.5 mb-0.5">
                      {cert.issuer === "JetBrains" && (
                        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/cert:text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M2.345 23.997A2.347 2.347 0 0 1 0 21.652V10.988C0 9.665.535 8.37 1.473 7.433l5.965-5.961A5.01 5.01 0 0 1 10.989 0h10.666A2.347 2.347 0 0 1 24 2.345v10.664a5.056 5.056 0 0 1-1.473 3.554l-5.965 5.965A5.017 5.017 0 0 1 13.007 24v-.003H2.345Zm8.969-6.854H5.486v1.371h5.828v-1.371ZM3.963 6.514h13.523v13.519l4.257-4.257a3.936 3.936 0 0 0 1.146-2.767V2.345c0-.678-.552-1.234-1.234-1.234H10.989a3.897 3.897 0 0 0-2.767 1.145L3.963 6.514Zm-.192.192L2.256 8.22a3.944 3.944 0 0 0-1.145 2.768v10.664c0 .678.552 1.234 1.234 1.234h10.666a3.9 3.9 0 0 0 2.767-1.146l1.512-1.511H3.771V6.706Z"/>
                        </svg>
                      )}
                      {cert.issuer === "LinkedIn Learning" && (
                        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/cert:text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.66 1.66 0 0 0-1.66 1.66c0 .92.74 1.66 1.66 1.66.92 0 1.66-.74 1.66-1.66 0-.92-.74-1.66-1.66-1.66Z"/>
                        </svg>
                      )}
                      {cert.issuer === "DeepLearning.AI" && (
                        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/cert:text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 2L3 7v10l9 5 9-5V7l-9-5zm0 2.2l6.8 3.8L12 11.8 5.2 8 12 4.2zM4.8 9.5l6.4 3.6v7.3l-6.4-3.6V9.5zm8 10.9v-7.3l6.4-3.6v7.3l-6.4 3.6z"/>
                        </svg>
                      )}
                      {cert.issuer === "Amazon Web Services (AWS)" && (
                        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/cert:text-cyan-300" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M18.8 17.4c-5.4 3-12.1 3-17.5 0-.4-.2-.9.2-.6.6 5.8 3.5 13 3.5 18.8 0 .4-.3 0-.8-.7-.6zm1.7.4c-.3-.4-1-.2-1.2.2-.3.5-.2 1.3.2 1.7.5.5 1.4.6 2 .2.2-.2.2-.4 0-.6-.3-.3-.8-.7-1-.9.1-.2 0-.4 0-.6zM8.2 11.5c0-.6.3-1.1.9-1.4.6-.3 1.4-.4 2.4-.4.8 0 1.5.1 2.1.2v.9c-.6-.2-1.2-.3-1.9-.3-.8 0-1.3.1-1.6.2-.3.2-.5.5-.5.8 0 .4.2.7.5.8.4.2 1 .3 1.9.5 1.1.2 1.9.5 2.3.9.5.4.7 1 .7 1.8 0 .9-.4 1.6-1.1 2-.7.5-1.7.7-2.9.7-1 0-1.9-.1-2.7-.4v-1c.8.3 1.7.5 2.6.5.9 0 1.5-.1 1.9-.4.4-.3.6-.6.6-1 0-.4-.2-.7-.5-.9-.4-.2-1-.4-2-.5-1.1-.2-1.8-.5-2.2-.9-.4-.4-.6-.9-.6-1.6z"/>
                        </svg>
                      )}
                      {cert.issuer === "Astronomer" && (
                        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover/cert:text-cyan-300" viewBox="0 0 512 512" fill="currentColor">
                          <path d="M268.619 28.1254C207.169 30.1204 150.174 55.9243 108.128 100.8C21.3364 193.46 26.0594 339.476 118.657 426.316C149.94 455.699 188.852 475.688 230.949 484L243.164 453.448C204.756 447.063 169.107 429.42 140.728 402.752C61.1145 328.088 57.0524 202.545 131.675 122.888C167.829 84.2989 216.831 62.1088 269.662 60.3988C271.85 60.3266 274.04 60.2905 276.23 60.2905C315.642 60.2184 354.161 72.0249 386.768 94.1713L399 63.5623C362.481 40.3861 320.236 28 276.253 28C273.712 28 271.171 28.0399 268.619 28.1254ZM291.921 144.97H259.891L259.503 145.939L177.948 349.902L177.104 352.011H213.333L213.715 351.03L233.723 299.559H321.66L341.919 351.042L342.301 352.011H379.686L378.849 349.902L326.189 218.209L325.802 217.24H289.579L290.394 219.332L309.069 267.36H246.571L293.351 147.067L294.165 144.975L291.921 144.97Z"/>
                        </svg>
                      )}
                      <span class="text-[10px] text-cyan-400 font-semibold block tracking-wide">{cert.issuer}</span>
                    </div>

                    <!-- Certificate Title with Hover Style -->
                    <span class="text-slate-200 font-medium text-xs truncate block group-hover/cert:text-white group-hover/cert:underline underline-offset-2 transition-colors">
                      {cert.title}
                    </span>
                  </div>
                </div>

                <!-- Year and External Redirect Arrow Indicator -->
                <div class="flex items-center gap-1 shrink-0 text-slate-400 group-hover/cert:text-cyan-400 transition-colors mt-0.5">
                  <span class="text-[10px] font-mono">{cert.year}</span>
                  <svg class="w-2.5 h-2.5 opacity-0 group-hover/cert:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M7 17L17 7M17 7H7M17 7V17"/>
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>

    </div>

  </div>
</section>
