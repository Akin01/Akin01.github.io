---

<section class="py-20 bg-dark-bg border-b border-[#202534] overflow-hidden" id="experience">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (Prefix title only, no big title, no divider) -->
    <div class="mb-12">
      <h2 class="font-mono text-xs sm:text-sm text-cyan-400 tracking-widest font-semibold uppercase">
        // PROFESSIONAL TRAJECTORY & EXPERIENCE
      </h2>
    </div>

    <!-- Interactive Subway / Transit Style Career Map Container -->
    <div class="relative w-full py-4" id="experience-route-container">
      
      <!-- Multi-Curve SVG Route Track: Active line drawn on scroll -->
      <svg 
        id="experience-route-svg" 
        class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible"
      >
        <!-- Animated cyan route line filled on scroll -->
        <path 
          id="route-track-fill" 
          fill="none" 
          stroke="#00e5ff" 
          stroke-width="3" 
          stroke-linecap="round" 
          stroke-linejoin="round"
          class="transition-opacity duration-300"
          style="filter: drop-shadow(0 0 8px rgba(0, 229, 255, 0.7));"
        />
      </svg>

      <!-- Alternating Station Rows -->
      <div class="space-y-12 sm:space-y-16 relative z-10" id="route-stations-list">
        {experiences.map((exp, idx) => (
          <div 
            class={`route-station relative flex flex-col ${idx % 2 === 0 ? 'md:items-start' : 'md:items-end'}`}
            data-station-index={idx}
          >
            <!-- Station Card -->
            <div 
              class={`station-card p-5 sm:p-6 w-full md:w-[47%] relative ${
                idx % 2 === 0 
                  ? 'station-card-left md:mr-auto ml-7 md:ml-0' 
                  : 'station-card-right ml-7 md:ml-0'
              }`}
            >
              
              <!-- Card Header Row -->
              <div class="station-card-header pb-3 mb-3 border-b border-[#202534]">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-base sm:text-lg font-bold text-white transition-colors">
                    {exp.role}
                  </h3>
                  <span class="text-cyan-400 font-mono text-xs font-semibold">@ {exp.company}</span>
                </div>
                <div class="font-mono text-xs text-slate-400 mt-0.5 flex items-center gap-2">
                  <span class="text-slate-300 font-semibold">{exp.city}</span>
                  <span>•</span>
                  <span>{exp.period}</span>
                </div>
              </div>

              <!-- Bullet Points -->
              <ul class="space-y-2 text-xs text-slate-300 mb-4 font-sans">
                {exp.highlights.map(item => (
                  <li class="station-bullet-item flex items-start gap-2">
                    <span class="text-cyan-400 font-mono text-xs mt-0.5">&gt;</span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>

              <!-- Tech Stack Tags -->
              <div class="station-card-tags flex flex-wrap items-center gap-1 pt-3 border-t border-[#202534]">
                <span class="text-[10px] font-mono text-slate-400 mr-2">STACK:</span>
                {exp.techStack.map(t => (
                  <span class="px-2 py-0.5 bg-[#0a0c12] border border-[#1e2332] font-mono text-[10px] text-slate-300">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Station Node Marker: Initially hidden, pops in when line connects -->
            <div 
              class={`route-station-node absolute top-6 z-20 w-4 h-4 bg-dark-bg border-2 border-[#2b354e] flex items-center justify-center ${
                idx % 2 === 0 
                  ? 'left-0 md:left-[47.5%]' 
                  : 'left-0 md:left-[52.5%]'
              }`}
              data-node-index={idx}
            >
              <div class="w-1.5 h-1.5 bg-slate-600 station-inner-dot"></div>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* Frosted Glass styling for station cards */
  .station-card {
    background-color: rgba(13, 16, 25, 0.76) !important;
    backdrop-filter: blur(12px) saturate(140%) !important;
    background-clip: padding-box;
    border: 1px solid rgba(34, 211, 238, 0.22) !important;
    box-shadow: 0 14px 34px -10px rgba(0, 0, 0, 0.5), inset 0 1px 0 0 rgba(255, 255, 255, 0.1) !important;
    transform-style: preserve-3d;
    will-change: transform, opacity;
  }

  .route-station {
    perspective: 1200px;
  }

  .station-card:hover {
    border-color: rgba(0, 229, 255, 0.6) !important;
    box-shadow: 0 20px 42px -10px rgba(0, 229, 255, 0.18), inset 0 1px 0 0 rgba(0, 229, 255, 0.35) !important;
  }

  /* Node styling */
  .route-station-node {
    opacity: 0;
    transform: scale(0);
    transition: opacity 0.35s ease-out, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .route-station-node.node-connected {
    opacity: 1 !important;
    transform: scale(1.22) !important;
    border-color: #00e5ff !important;
    box-shadow: 0 0 16px rgba(0, 229, 255, 0.7) !important;
  }

  .route-station-node.node-connected .station-inner-dot {
    background-color: #00e5ff !important;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function setupRouteMapAnimation() {
    const container = document.getElementById('experience-route-container');
    const pathFill = document.getElementById('route-track-fill') as SVGPathElement | null;
    const nodes = document.querySelectorAll('.route-station-node');
    const stations = document.querySelectorAll('.route-station');

    if (!container || !pathFill || nodes.length < 2) return;

    // Calculate exact coordinates of station nodes relative to container
    function renderPath() {
      if (!container || !pathFill) return;
      const containerRect = container.getBoundingClientRect();
      const points: { x: number; y: number }[] = [];

      nodes.forEach(node => {
        const rect = node.getBoundingClientRect();
        const x = rect.left - containerRect.left + rect.width / 2;
        const y = rect.top - containerRect.top + rect.height / 2;
        points.push({ x, y });
      });

      // Construct multi-curve cubic bezier path
      let d = `M ${points[0].x} ${points[0].y}`;
      for (let i = 0; i < points.length - 1; i++) {
        const pA = points[i];
        const pB = points[i + 1];
        const midY = (pA.y + pB.y) / 2;
        d += ` C ${pA.x} ${midY}, ${pB.x} ${midY}, ${pB.x} ${pB.y}`;
      }

      pathFill.setAttribute('d', d);

      const length = pathFill.getTotalLength();
      pathFill.style.strokeDasharray = `${length}`;
      pathFill.style.strokeDashoffset = `${length}`;

      return length;
    }

    const pathLength = renderPath();
    if (!pathLength) return;

    // 1. Line draws on scroll in sync with Lenis
    gsap.to(pathFill, {
      strokeDashoffset: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '#experience-route-container',
        start: 'top 70%',
        end: 'bottom 85%',
        scrub: 1.0,
        onUpdate: (self) => {
          const progress = self.progress;
          nodes.forEach((node, idx) => {
            const milestoneProgress = idx / (nodes.length - 1);
            if (progress >= milestoneProgress * 0.94) {
              node.classList.add('node-connected');
            } else {
              node.classList.remove('node-connected');
            }
          });
        }
      }
    });

    // 2. Card position moves from outside based on scroll (SCRUBBED)
    // Once card reaches its resting position (at top 52%), internal content staggers in!
    stations.forEach((station) => {
      const card = station.querySelector('.station-card') as HTMLElement;
      if (!card) return;

      const isLeft = card.classList.contains('station-card-left');
      const baseAngle = isLeft ? -1.2 : 1.2;
      const startX = isLeft 
        ? -Math.min(window.innerWidth * 0.9, 900) 
        : Math.min(window.innerWidth * 0.9, 900);

      // Card position strictly moves based on scroll
      gsap.fromTo(card,
        {
          x: startX,
          rotation: isLeft ? -6 : 6,
          opacity: 0,
          scale: 0.92
        },
        {
          x: 0,
          rotation: baseAngle,
          opacity: 1,
          scale: 1,
          ease: 'power1.out',
          scrollTrigger: {
            trigger: station,
            start: 'top 95%',
            end: 'top 52%',
            scrub: 1.0,
            onEnter: () => {
              card.style.pointerEvents = 'auto';
            },
            onLeaveBack: () => {
              card.style.pointerEvents = 'none';
            }
          }
        }
      );

      // After reaching position (top 52%), trigger stagger effect on card contents
      const header = card.querySelector('.station-card-header');
      const bullets = Array.from(card.querySelectorAll('.station-bullet-item'));
      const tags = card.querySelector('.station-card-tags');
      const elementsToStagger = [header, ...bullets, tags].filter(Boolean);

      gsap.fromTo(elementsToStagger,
        { opacity: 0, y: 16 },
        {
          opacity: 1,
          y: 0,
          duration: 0.38,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: station,
            start: 'top 52%',
            toggleActions: 'play reverse play reverse'
          }
        }
      );
    });

    // Re-render path on window resize
    window.addEventListener('resize', () => {
      renderPath();
      ScrollTrigger.refresh();
    });

    setupCardHoverSkew();
  }

  // Dynamic cursor-follow skew & tilt for station cards
  function setupCardHoverSkew() {
    const cards = Array.from(document.querySelectorAll('.station-card')) as HTMLElement[];
    cards.forEach((card) => {
      const isLeft = card.classList.contains('station-card-left');
      const baseRotation = isLeft ? -1.2 : 1.2;

      card.addEventListener('pointermove', (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        // Normalized coordinates between -0.5 and +0.5 from center of card
        const normX = (e.clientX - rect.left) / rect.width - 0.5;
        const normY = (e.clientY - rect.top) / rect.height - 0.5;

        // Dynamic skew and rotation following cursor
        const targetSkewX = -normX * 8.0;
        const targetSkewY = normY * 5.0;
        const targetRotateZ = baseRotation + normX * 3.0;

        gsap.to(card, {
          skewX: targetSkewX,
          skewY: targetSkewY,
          rotation: targetRotateZ,
          scale: 1.02,
          duration: 0.15,
          ease: 'power1.out',
          overwrite: 'auto'
        });
      });

      card.addEventListener('pointerleave', () => {
        // Smoothly settle back to base rotation and zero skew
        gsap.to(card, {
          skewX: 0,
          skewY: 0,
          rotation: baseRotation,
          scale: 1,
          duration: 0.35,
          ease: 'power2.out',
          overwrite: 'auto'
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRouteMapAnimation);
  } else {
    setupRouteMapAnimation();
  }
</script>
